# Technitium DNS API URL
# If deploying separately, point to your Technitium server
VITE_API_URL=http://localhost:5380/api

# Cluster "Add Node" proxy allow-list (comma-separated domains).
# Required to enroll a not-yet-clustered node (e.g. ns2) from the primary's UI.
# A target host is allowed if it equals, or is a subdomain of, a listed domain.
# Leave unset to disable the feature (the proxy then refuses every request).
# CLUSTER_NODE_ALLOWED_DOMAINS=dns.example.com
